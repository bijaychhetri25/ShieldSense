
import sys
from pathlib import Path
from datetime import datetime
from html import escape

import streamlit as st


# ---------------------------------
# Project imports
# ---------------------------------

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from model_evaluation.rules_baseline import classify_message
from model_evaluation.ml_predictor import predict_message


# ---------------------------------
# Page configuration
# ---------------------------------

st.set_page_config(
    page_title="ShieldSense | Scam Detection",
    page_icon="🛡️",
    layout="centered"
)


# ---------------------------------
# Session state
# ---------------------------------

if "scan_history" not in st.session_state:
    st.session_state.scan_history = []

if "latest_result" not in st.session_state:
    st.session_state.latest_result = None


# ---------------------------------
# Custom styling
# ---------------------------------

st.markdown("""
<style>
    .main-title {
        text-align: center;
        color: #2563eb;
        font-size: 42px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .subtitle {
        text-align: center;
        font-size: 18px;
        color: #64748b;
        margin-bottom: 25px;
    }

    .risk-card {
        padding: 24px;
        border-radius: 14px;
        margin: 15px 0;
        border: 2px solid;
    }

    .low-risk {
        background: #dcfce7;
        color: #14532d;
        border-color: #15803d;
    }

    .medium-risk {
        background: #fef3c7;
        color: #78350f;
        border-color: #b45309;
    }

    .high-risk {
        background: #fee2e2;
        color: #7f1d1d;
        border-color: #b91c1c;
    }

    .risk-card h2 {
        color: inherit;
        margin: 0 0 10px 0;
    }

    .risk-card p {
        color: inherit;
        margin: 0;
    }

